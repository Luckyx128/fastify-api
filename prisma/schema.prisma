generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}

model Agendamento {
  id              Int      @id @default(autoincrement())
  name            String
  phone_number    String
  email           String   @unique
  scheduling_date DateTime
  id_service      Int
  createdAt       DateTime @default(now())
}
